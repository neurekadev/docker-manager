# Build output
/dist/
/coverage.out
*.test
*.exe
*.prof

# Local runtime data (never commit databases or keys)
/data/
*.db
*.db-wal
*.db-shm
secret.key

# Local environment files
.env
!.env.example

# TLS material for the deploy examples (only their READMEs are tracked)
/deploy/*/certs/*
!/deploy/*/certs/README.md

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Agent tooling
/.claude/

# Go fuzz cache output written next to tests (commit only curated seeds)
**/testdata/fuzz/**/*.tmp

# SvelteKit output generated by running its tooling at the repository root
/.svelte-kit/

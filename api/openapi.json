{
  "components": {
    "schemas": {
      "CapabilitiesBody": {
        "additionalProperties": false,
        "properties": {
          "agentProtocolVersion": {
            "examples": [
              "dockyard.agent/v1"
            ],
            "type": "string"
          },
          "apiVersion": {
            "examples": [
              "v1"
            ],
            "type": "string"
          },
          "features": {
            "description": "Stable feature-flag keys enabled on this manager.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "managerVersion": {
            "examples": [
              "0.0.0-edge"
            ],
            "type": "string"
          }
        },
        "required": [
          "managerVersion",
          "apiVersion",
          "agentProtocolVersion",
          "features"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Stable snake_case error code; switch on this, not on message.",
            "examples": [
              "not_found"
            ],
            "type": "string"
          },
          "details": {
            "description": "Per-field problems, empty when not applicable.",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "message": {
            "description": "Human-readable summary. Not stable; do not parse.",
            "examples": [
              "stack not found"
            ],
            "type": "string"
          },
          "requestId": {
            "description": "Request ID echoed in the X-Request-ID header and the manager logs.",
            "examples": [
              "4f1c2e7a9b0d4c3e8f6a1b2c3d4e5f60"
            ],
            "type": "string"
          },
          "retryable": {
            "description": "True when repeating the identical request later may succeed.",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "requestId",
          "retryable"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "description": "Input location, e.g. body.name, query.limit, path.stackId, header.If-Match.",
            "examples": [
              "body.name"
            ],
            "type": "string"
          },
          "message": {
            "description": "What is wrong with the value.",
            "examples": [
              "expected length >= 1"
            ],
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "type": "object"
      },
      "HealthBody": {
        "additionalProperties": false,
        "properties": {
          "commit": {
            "description": "Source commit the manager was built from.",
            "type": "string"
          },
          "status": {
            "description": "Always ok when the process can serve requests.",
            "enum": [
              "ok"
            ],
            "type": "string"
          },
          "version": {
            "description": "Manager build version.",
            "examples": [
              "0.0.0-edge"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "commit"
        ],
        "type": "object"
      },
      "ReadinessBody": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ReadinessCheck"
            },
            "type": "array"
          },
          "status": {
            "enum": [
              "ready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "type": "object"
      },
      "ReadinessCheck": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "name": {
            "examples": [
              "database"
            ],
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ok"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Public control API of the DockYard manager. All routes live under /api/v1 on the single public origin. Errors use the Error schema with media type application/problem+json. Every operation declares the capability it requires (x-dockyard-capability) and the scope at which it is checked (x-dockyard-scope).",
    "title": "DockYard API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "description": "Versions and feature flags clients use to adapt to this manager.",
        "operationId": "get-capabilities",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Manager capabilities",
        "tags": [
          "System"
        ],
        "x-dockyard-capability": "public",
        "x-dockyard-scope": "none"
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Reports that the manager process is serving requests. Used by the container HEALTHCHECK.",
        "operationId": "get-health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Liveness",
        "tags": [
          "System"
        ],
        "x-dockyard-capability": "public",
        "x-dockyard-scope": "none"
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Reports whether the manager can serve traffic: the database is reachable and all migrations are applied. Returns 503 not_ready with one detail per failing check otherwise.",
        "operationId": "get-health-ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessBody"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readiness",
        "tags": [
          "System"
        ],
        "x-dockyard-capability": "public",
        "x-dockyard-scope": "none"
      }
    }
  }
}

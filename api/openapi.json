{
  "components": {
    "schemas": {
      "CapabilitiesBody": {
        "additionalProperties": false,
        "properties": {
          "agentProtocolVersion": {
            "examples": [
              "dockyard.agent/v1"
            ],
            "type": "string"
          },
          "apiVersion": {
            "examples": [
              "v1"
            ],
            "type": "string"
          },
          "features": {
            "description": "Stable feature-flag keys enabled on this manager.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "managerVersion": {
            "examples": [
              "0.0.0-edge"
            ],
            "type": "string"
          }
        },
        "required": [
          "managerVersion",
          "apiVersion",
          "agentProtocolVersion",
          "features"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Stable snake_case error code; switch on this, not on message.",
            "examples": [
              "not_found"
            ],
            "type": "string"
          },
          "details": {
            "description": "Per-field problems, empty when not applicable.",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "message": {
            "description": "Human-readable summary. Not stable; do not parse.",
            "examples": [
              "stack not found"
            ],
            "type": "string"
          },
          "requestId": {
            "description": "Request ID echoed in the X-Request-ID header and the manager logs.",
            "examples": [
              "4f1c2e7a9b0d4c3e8f6a1b2c3d4e5f60"
            ],
            "type": "string"
          },
          "retryable": {
            "description": "True when repeating the identical request later may succeed.",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "requestId",
          "retryable"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "description": "Input location, e.g. body.name, query.limit, path.stackId, header.If-Match.",
            "examples": [
              "body.name"
            ],
            "type": "string"
          },
          "message": {
            "description": "What is wrong with the value.",
            "examples": [
              "expected length >= 1"
            ],
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "type": "object"
      },
      "HealthBody": {
        "additionalProperties": false,
        "properties": {
          "commit": {
            "description": "Source commit the manager was built from.",
            "type": "string"
          },
          "status": {
            "description": "Always ok when the process can serve requests.",
            "enum": [
              "ok"
            ],
            "type": "string"
          },
          "version": {
            "description": "Manager build version.",
            "examples": [
              "0.0.0-edge"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "commit"
        ],
        "type": "object"
      },
      "Job": {
        "additionalProperties": false,
        "properties": {
          "attempt": {
            "description": "Dispatch attempt; increases when an interrupted job resumes or a lost command is re-sent.",
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "blockedBy": {
            "$ref": "#/components/schemas/JobBlockedBy",
            "description": "Present while the job is blocked."
          },
          "cancelRequested": {
            "type": "boolean"
          },
          "cancellable": {
            "description": "False once the job reached a terminal state.",
            "type": "boolean"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "dispatchedAt": {
            "format": "date-time",
            "type": "string"
          },
          "environmentId": {
            "type": "string"
          },
          "error": {
            "$ref": "#/components/schemas/JobError",
            "description": "Present for failed, partial, cancelled and interrupted jobs."
          },
          "executor": {
            "enum": [
              "agent",
              "manager"
            ],
            "type": "string"
          },
          "finishedAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "examples": [
              "0190a6e0-0000-7000-8000-000000000001"
            ],
            "type": "string"
          },
          "initiatorTokenId": {
            "description": "API token used to request the job (audit metadata only).",
            "type": "string"
          },
          "initiatorUserId": {
            "description": "User who requested the job (audit metadata only).",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/JobItem"
            },
            "type": "array"
          },
          "kind": {
            "description": "Job kind from the catalog in docs/architecture/job-engine.md.",
            "examples": [
              "stack.deploy"
            ],
            "type": "string"
          },
          "locks": {
            "description": "The job's lock scopes (held while dispatched, running or cancelling).",
            "items": {
              "$ref": "#/components/schemas/JobLock"
            },
            "type": "array"
          },
          "locksHeld": {
            "type": "boolean"
          },
          "origin": {
            "description": "Why the job exists. Audit metadata, not an access-control owner.",
            "enum": [
              "manual",
              "scheduled",
              "api_token"
            ],
            "type": "string"
          },
          "policyId": {
            "description": "Policy that scheduled the job.",
            "type": "string"
          },
          "progress": {
            "$ref": "#/components/schemas/JobProgress"
          },
          "startedAt": {
            "description": "When the current attempt was acknowledged by its executor.",
            "format": "date-time",
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "blocked",
              "dispatched",
              "running",
              "cancelling",
              "succeeded",
              "failed",
              "partial",
              "cancelled",
              "interrupted"
            ],
            "type": "string"
          },
          "targets": {
            "items": {
              "$ref": "#/components/schemas/JobTarget"
            },
            "type": "array"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "state",
          "origin",
          "executor",
          "targets",
          "attempt",
          "progress",
          "items",
          "locks",
          "locksHeld",
          "cancelRequested",
          "cancellable",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "JobBlockedBy": {
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "description": "The job holding (or queued first for) the conflicting lock or concurrency slot.",
            "type": "string"
          },
          "reason": {
            "enum": [
              "lock",
              "agent_offline",
              "concurrency_limit"
            ],
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "JobError": {
        "additionalProperties": false,
        "properties": {
          "class": {
            "description": "Stable error class, e.g. agent_offline, authorization_revoked, step_failed, unknown_outcome, journal_lost, cancelled.",
            "examples": [
              "agent_offline"
            ],
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recovery": {
            "description": "What the operator should do next.",
            "type": "string"
          }
        },
        "required": [
          "class",
          "message",
          "recovery"
        ],
        "type": "object"
      },
      "JobEvent": {
        "additionalProperties": false,
        "properties": {
          "at": {
            "format": "date-time",
            "type": "string"
          },
          "item": {
            "$ref": "#/components/schemas/JobItem"
          },
          "message": {
            "type": "string"
          },
          "percent": {
            "format": "int64",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "seq": {
            "description": "Monotonic per job; also the SSE event id.",
            "format": "int64",
            "type": "integer"
          },
          "state": {
            "type": "string"
          },
          "step": {
            "type": "string"
          },
          "type": {
            "enum": [
              "state",
              "progress",
              "item",
              "log",
              "warning"
            ],
            "type": "string"
          }
        },
        "required": [
          "seq",
          "at",
          "type"
        ],
        "type": "object"
      },
      "JobItem": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "skipped"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "type": "object"
      },
      "JobLock": {
        "additionalProperties": false,
        "properties": {
          "environmentId": {
            "description": "Absent for instance-wide scopes (repository).",
            "type": "string"
          },
          "mode": {
            "enum": [
              "shared",
              "exclusive"
            ],
            "type": "string"
          },
          "name": {
            "description": "Resource name; * locks every resource of the scope in the environment; absent for host.",
            "type": "string"
          },
          "scope": {
            "enum": [
              "host",
              "stack",
              "container",
              "volume",
              "image",
              "network",
              "file_path",
              "repository"
            ],
            "type": "string"
          }
        },
        "required": [
          "scope",
          "mode"
        ],
        "type": "object"
      },
      "JobProgress": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "percent": {
            "description": "Completion percentage; absent when unknown.",
            "format": "int64",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "step": {
            "description": "Current step of the kind's plan.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "JobTarget": {
        "additionalProperties": false,
        "properties": {
          "environmentId": {
            "description": "Environment of the target when it differs from the job's (migrations).",
            "type": "string"
          },
          "id": {
            "description": "Resource identifier within its environment (stack ID, container, volume or network name, image reference, repository ID, absolute path).",
            "type": "string"
          },
          "type": {
            "description": "Target resource type.",
            "enum": [
              "stack",
              "container",
              "volume",
              "image",
              "network",
              "repository",
              "path",
              "destination_path"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "id"
        ],
        "type": "object"
      },
      "PageJob": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "Items on this page (possibly empty, also when nextCursor is present).",
            "items": {
              "$ref": "#/components/schemas/Job"
            },
            "type": "array"
          },
          "nextCursor": {
            "description": "Opaque cursor for the next page; absent on the last page.",
            "type": "string"
          },
          "total": {
            "description": "Number of items matching the filters that the caller may see, across all pages. Only on routes that document it.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ReadinessBody": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ReadinessCheck"
            },
            "type": "array"
          },
          "status": {
            "enum": [
              "ready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "type": "object"
      },
      "ReadinessCheck": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "name": {
            "examples": [
              "database"
            ],
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ok"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerToken": {
        "bearerFormat": "DockYard API token",
        "description": "Scoped, expiring API token (#31) sent as Authorization: Bearer <token>. A token carries a subset of its owner's capabilities; each request is evaluated as token scope intersected with the owner's current effective permissions.",
        "scheme": "bearer",
        "type": "http"
      },
      "cookieSession": {
        "description": "Browser session (#16). Set by POST /api/v1/auth/session as an HttpOnly, Secure, SameSite=Strict cookie. Unsafe methods authenticated by this cookie must come from the manager's own origin (Origin/Sec-Fetch-Site checks).",
        "in": "cookie",
        "name": "__Host-dockyard_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Public control API of the DockYard manager. All routes live under /api/v1 on the single public origin. Errors use the Error schema with media type application/problem+json. Every operation declares the capability it requires (x-dockyard-capability) and the scope at which it is checked (x-dockyard-scope). Browsers authenticate with the session cookie, other clients with a bearer API token. Conventions, errors, streams and versioning: docs/api/README.md in the DockYard repository.",
    "title": "DockYard API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "description": "Versions and feature flags clients use to adapt to this manager.",
        "operationId": "get-capabilities",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Manager capabilities",
        "tags": [
          "System"
        ],
        "x-dockyard-capability": "public",
        "x-dockyard-scope": "none"
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Reports that the manager process is serving requests. Used by the container HEALTHCHECK.",
        "operationId": "get-health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Liveness",
        "tags": [
          "System"
        ],
        "x-dockyard-capability": "public",
        "x-dockyard-scope": "none"
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Reports whether the manager can serve traffic: the database is reachable and all migrations are applied. Returns 503 not_ready with one detail per failing check otherwise.",
        "operationId": "get-health-ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessBody"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readiness",
        "tags": [
          "System"
        ],
        "x-dockyard-capability": "public",
        "x-dockyard-scope": "none"
      }
    },
    "/api/v1/jobs": {
      "get": {
        "description": "Jobs visible to the caller, newest first. Visibility is decided per job by job.read on the job's targets (never by who created it), so pages may hold fewer than limit items; follow nextCursor until it is absent.",
        "operationId": "list-jobs",
        "parameters": [
          {
            "description": "Opaque cursor from a previous page's nextCursor. Only valid with the same filters and sort.",
            "explode": false,
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Opaque cursor from a previous page's nextCursor. Only valid with the same filters and sort.",
              "maxLength": 512,
              "type": "string"
            }
          },
          {
            "description": "Maximum number of items to return.",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "description": "Maximum number of items to return.",
              "format": "int64",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Only jobs in these states.",
            "explode": false,
            "in": "query",
            "name": "state",
            "schema": {
              "description": "Only jobs in these states.",
              "items": {
                "enum": [
                  "queued",
                  "blocked",
                  "dispatched",
                  "running",
                  "cancelling",
                  "succeeded",
                  "failed",
                  "partial",
                  "cancelled",
                  "interrupted"
                ],
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "Only jobs of this kind.",
            "explode": false,
            "in": "query",
            "name": "kind",
            "schema": {
              "description": "Only jobs of this kind.",
              "maxLength": 64,
              "type": "string"
            }
          },
          {
            "description": "Only jobs in (or targeting) this environment.",
            "explode": false,
            "in": "query",
            "name": "environmentId",
            "schema": {
              "description": "Only jobs in (or targeting) this environment.",
              "maxLength": 128,
              "type": "string"
            }
          },
          {
            "description": "Only jobs with this target, as type:id (e.g. stack:0190a6e0-...).",
            "explode": false,
            "in": "query",
            "name": "target",
            "schema": {
              "description": "Only jobs with this target, as type:id (e.g. stack:0190a6e0-...).",
              "maxLength": 1100,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageJob"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "cookieSession": []
          },
          {
            "bearerToken": []
          }
        ],
        "summary": "List jobs",
        "tags": [
          "Jobs"
        ],
        "x-dockyard-capability": "job.read",
        "x-dockyard-scope": "resource"
      }
    },
    "/api/v1/jobs/{jobId}": {
      "get": {
        "operationId": "get-job",
        "parameters": [
          {
            "description": "Job ID.",
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "description": "Job ID.",
              "maxLength": 64,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "cookieSession": []
          },
          {
            "bearerToken": []
          }
        ],
        "summary": "Get a job",
        "tags": [
          "Jobs"
        ],
        "x-dockyard-capability": "job.read",
        "x-dockyard-scope": "resource"
      }
    },
    "/api/v1/jobs/{jobId}/cancellations": {
      "post": {
        "description": "Queued and blocked jobs are cancelled immediately. Running jobs move to cancelling and stop at the next cancellation safe point of their kind; compensating steps (such as restarting containers stopped for a backup) always run. A job that finishes before reaching a safe point keeps its outcome. Repeating the request is harmless. Answers 202 with the job and its URL in Location. 409 job_finished when the job already finished.",
        "operationId": "create-job-cancellation",
        "parameters": [
          {
            "description": "Job ID.",
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "description": "Job ID.",
              "maxLength": 64,
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "Accepted",
            "headers": {
              "Location": {
                "schema": {
                  "description": "URL of the job.",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {

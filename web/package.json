{
	"name": "dockyard-web",
	"private": true,
	"version": "0.0.0-edge",
	"type": "module",
	"engines": {
		"node": ">=26 <27",
		"npm": ">=11"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"generate:api": "openapi-typescript ../api/openapi.json --output src/lib/api/schema.d.ts"
	},
	"dependencies": {
		"@codemirror/lang-yaml": "6.1.3",
		"@lucide/svelte": "1.48.0",
		"@sveltejs/kit": "^2.63.0",
		"@tanstack/svelte-query": "6.2.4",
		"@xterm/xterm": "6.0.0",
		"bits-ui": "2.19.3",
		"codemirror": "6.0.2",
		"echarts": "6.1.0",
		"openapi-fetch": "^0.17.0",
		"svelte": "^5.56.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.6.2",
		"@vite-pwa/sveltekit": "1.1.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte-check": "^4.6.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}

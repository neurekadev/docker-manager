# One origin, one route: everything goes to the manager (#27).
# DOCKYARD_TLS=internal uses Caddy's local CA (trust it on your clients or
# accept the warning); set it to an email address to use ACME/Let's Encrypt
# for a publicly reachable DOCKYARD_HOST.
{$DOCKYARD_HOST} {
	tls {$DOCKYARD_TLS}

	reverse_proxy dockyard-manager:8080 {
		# Stream SSE and WebSocket traffic (live updates, logs, agent sessions)
		# without buffering.
		flush_interval -1
	}
}

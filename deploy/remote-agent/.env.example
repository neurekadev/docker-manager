# Copy to .env next to compose.yaml and adjust.

# The manager's public HTTPS origin (the same URL browsers use).
DOCKYARD_MANAGER_URL=https://docker.example.com

# Optional extra CA bundle (PEM) for a private PKI, as a path inside the
# container (the dockyard_agent_ca volume is mounted at /etc/dockyard/ca).
# Leave empty for publicly trusted certificates.
DOCKYARD_MANAGER_CA_FILE=

# One-use enrollment token created in the UI (#3). Remove it after the
# agent has enrolled.
DOCKYARD_ENROLLMENT_TOKEN=

# Optional initial display name of this Environment.
DOCKYARD_ENVIRONMENT_NAME=

# debug | info | warn | error
DOCKYARD_LOG_LEVEL=info

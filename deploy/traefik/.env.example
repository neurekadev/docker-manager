# Copy to .env next to compose.yaml and adjust.

# Public host name of the single DockYard origin (https://<host>).
DOCKYARD_HOST=localhost

# TLS, either:
#  - Let's Encrypt: leave the two file variables empty and set an email; the
#    host must be publicly reachable on port 443, or
#  - your own certificate: put the PEM files into ./certs (or DOCKYARD_TLS_DIR)
#    and name them here as paths inside the container.
DOCKYARD_ACME_EMAIL=
DOCKYARD_TLS_DIR=./certs
DOCKYARD_TLS_CERT_FILE=
DOCKYARD_TLS_KEY_FILE=
# DOCKYARD_TLS_CERT_FILE=/certs/fullchain.pem
# DOCKYARD_TLS_KEY_FILE=/certs/privkey.pem

# Published proxy ports.
DOCKYARD_HTTP_PORT=80
DOCKYARD_HTTPS_PORT=443

# Internal network and the proxy's fixed address on it. The manager trusts
# X-Forwarded-* headers only from DOCKYARD_PROXY_IP. Change both if the
# subnet overlaps a network on your host.
DOCKYARD_SUBNET=10.227.27.0/24
DOCKYARD_PROXY_IP=10.227.27.10

# One-use enrollment token for the co-located agent, created in the UI (#3).
DOCKYARD_ENROLLMENT_TOKEN=

# Optional initial display name of this Environment.
DOCKYARD_ENVIRONMENT_NAME=

# debug | info | warn | error
DOCKYARD_LOG_LEVEL=info

# E2E TLS reverse proxy: one origin, Caddy's internal CA (the e2e workflow
# job trusts its root in the browser), unbuffered streaming like
# deploy/compose/Caddyfile.
{
	local_certs
	skip_install_trust
}

localhost {
	tls internal

	# Stream fixture for the Playwright SSE/WebSocket helpers (test only).
	handle_path /__e2e/echo/* {
		reverse_proxy echo:8080 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy dockyard-manager:8080 {
			flush_interval -1
		}
	}
}
